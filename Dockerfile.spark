FROM apache/spark:4.2.0-scala2.13-java21-python3-ubuntu

USER root

RUN apt-get update && \
    apt-get install -y --no-install-recommends software-properties-common curl ca-certificates && \
    add-apt-repository -y ppa:deadsnakes/ppa && \
    apt-get update && \
    apt-get install -y --no-install-recommends python3.13 python3.13-venv python3.13-dev && \
    rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11.29 /uv /uvx /usr/local/bin/

# Venv lives OUTSIDE /opt/retailflow on purpose: that path is bind-mounted
# over at runtime (see compose volumes), which would shadow anything built here.
ENV UV_PROJECT_ENVIRONMENT=/opt/.spark-venv
ENV PYSPARK_PYTHON=/opt/.spark-venv/bin/python3.13
ENV PYSPARK_DRIVER_PYTHON=/opt/.spark-venv/bin/python3.13

WORKDIR /opt/retailflow-build
COPY pyproject.toml uv.lock ./

RUN uv sync --frozen --no-cache --python python3.13 && \
    chown -R spark:spark /opt/.spark-venv

RUN mkdir -p /tmp/spark-home/.ivy2 && \
    chown -R spark:spark /tmp/spark-home

WORKDIR /opt/retailflow
USER spark